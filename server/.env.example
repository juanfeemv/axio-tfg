# MongoDB
MONGO_URI=mongodb://localhost:27017/axio_db

# JWT
JWT_SECRET=cambiar-por-clave-secreta-segura

# Google Gemini AI (obtener en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu-api-key-de-gemini

# Cloudflare Tunnel (opcional, para acceso público)
# CLOUDFLARE_TUNNEL_TOKEN=tu-token-de-tunnel

# n8n Webhook (opcional, para notificaciones automatizadas)
# N8N_WEBHOOK_URL=https://tu-n8n-instancia/webhook/axio

# Orígenes permitidos para CORS (separados por coma)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Puerto del servidor (por defecto: 3000)
# PORT=3000
